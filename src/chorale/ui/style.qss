/* Tema gelap HarmoniSATB Studio. Token @nama diganti oleh theme.stylesheet(). */

QWidget {
    color: @text;
    font-family: @font_ui;
    font-size: 14px;
}

QMainWindow, QWidget#screen, QScrollArea, QScrollArea > QWidget > QWidget#scrollContent {
    background: @app;
}

QScrollArea { border: none; }

QLabel { background: transparent; }

/* ----- teks ----- */
QLabel[role="h1"] { font-size: 28px; font-weight: 700; }
QLabel[role="h2"] { font-size: 24px; font-weight: 700; }
QLabel[role="h3"] { font-size: 18px; font-weight: 600; }
QLabel[role="rowTitle"] { font-size: 18px; font-weight: 600; }
QLabel[role="appTitle"] { font-size: 20px; font-weight: 600; }
QLabel[role="subtitle"] { font-size: 16px; color: @text2; }
QLabel[role="section"] { font-size: 14px; font-weight: 500; color: @text2; letter-spacing: 1px; }
QLabel[role="field"] { font-size: 14px; font-weight: 500; color: @text2; }
QLabel[role="hint"] { font-size: 13px; color: @text2; }
QLabel[role="hintMono"] { font-size: 13px; color: @text2; font-family: @font_mono; }
QLabel[role="body"] { font-size: 15px; font-weight: 500; }
QLabel[role="secondary"] { font-size: 14px; color: @text2; }
QLabel[role="mono"] { font-size: 14px; color: @text2; font-family: @font_mono; }
QLabel[role="monoValue"] { font-size: 14px; font-weight: 500; font-family: @font_mono; }
QLabel[role="error"] { font-size: 13px; color: @red; }

/* ----- bilah atas ----- */
QFrame#topBar {
    background: @panel;
    border: none;
    border-bottom: 1px solid @border;
}

/* ----- kartu & panel ----- */
QFrame#card {
    background: @panel;
    border: 1px solid @border;
    border-radius: 8px;
}
QFrame#inset {
    background: @raised;
    border: 1px solid @border;
    border-radius: 8px;
}
QFrame#lockedField {
    background: rgba(31, 38, 48, 0.7);
    border: 1px solid @border;
    border-radius: 8px;
}
QFrame#separator { background: rgba(42, 51, 64, 0.6); border: none; max-height: 1px; min-height: 1px; }

/* ----- tombol ----- */
QPushButton {
    border-radius: 8px;
    padding: 0 20px;
    min-height: 48px;
    font-size: 15px;
    font-weight: 500;
    outline: none;
}
QPushButton[variant="primary"] { background: @blue; color: #FFFFFF; font-weight: 600; border: none; }
QPushButton[variant="primary"]:hover { background: @blue_hover; }
QPushButton[variant="primary"]:disabled { background: #24467A; color: rgba(255, 255, 255, 0.55); }
QPushButton[variant="hero"] {
    background: @blue; color: #FFFFFF; font-weight: 600; border: none;
    border-radius: 12px; min-height: 56px; padding: 0 32px; font-size: 16px;
}
QPushButton[variant="hero"]:hover { background: @blue_hover; }
QPushButton[variant="secondary"] { background: transparent; color: @text; border: 1px solid @border; }
QPushButton[variant="secondary"]:hover { background: @raised; }
QPushButton[variant="toolbar"] {
    background: @raised; color: @text; border: 1px solid @border;
    min-height: 34px; padding: 0 12px; font-size: 14px; font-weight: 400;
}
QPushButton[variant="toolbar"]:hover { background: @border; }
QPushButton[variant="square"] {
    background: @raised; border: 1px solid @border; min-height: 36px; min-width: 36px;
    max-height: 36px; max-width: 36px; padding: 0;
}
QPushButton[variant="square"]:hover { background: @border; }
QPushButton[variant="link"] {
    background: transparent; border: none; color: @text2; font-size: 16px; font-weight: 400;
    padding: 0; min-height: 28px; text-align: left;
}
QPushButton[variant="link"]:hover { color: @text; }
QPushButton[variant="icon"] {
    background: transparent; border: none; min-height: 32px; min-width: 32px; padding: 0; border-radius: 4px;
}
QPushButton[variant="icon"]:hover { background: @border; }
QPushButton[variant="step"] {
    background: transparent; border: none; color: @text2; min-height: 32px; min-width: 32px;
    max-width: 32px; padding: 0; border-radius: 4px; font-size: 18px; font-weight: 700;
}
QPushButton[variant="step"]:hover { color: @text; background: @border; }

/* ----- navigasi samping ----- */
QPushButton[variant="nav"] {
    background: transparent; border: none; border-left: 3px solid transparent; border-radius: 0;
    color: @text2; text-align: left; padding: 0 17px; font-size: 15px; font-weight: 400;
}
QPushButton[variant="nav"]:hover { color: @text; background: rgba(31, 38, 48, 0.5); }
QPushButton[variant="nav"]:checked { background: @raised; border-left: 3px solid @blue; color: #FFFFFF; font-weight: 500; }
QFrame#sideNav { background: @panel; border: none; border-right: 1px solid @border; }

/* ----- isian ----- */
QLineEdit {
    background: @raised; border: 1px solid @border; border-radius: 8px;
    min-height: 46px; padding: 0 16px; font-size: 16px; selection-background-color: @blue;
}
QLineEdit:focus { border: 1px solid @blue; }
QLineEdit[invalid="true"] { border: 1px solid @red; }

QLineEdit#stepperEdit {
    background: transparent; border: none; min-height: 0; padding: 0;
    font-family: @font_mono; font-size: 18px; font-weight: 600;
}

QComboBox {
    background: @raised; border: 1px solid @border; border-radius: 8px;
    min-height: 42px; padding: 0 16px; font-size: 15px;
}
QComboBox[compact="true"] { min-height: 38px; padding: 0 12px; font-size: 14px; }
QComboBox[mono="true"] { font-family: @font_mono; font-size: 14px; }
QComboBox:hover { border: 1px solid #4A5566; }
QComboBox:disabled { color: @text2; }
QComboBox::drop-down { border: none; width: 40px; }
QComboBox::down-arrow { image: url(@icon_chevron_down); width: 20px; height: 20px; }
QComboBox QAbstractItemView {
    background: @raised; border: 1px solid @border; selection-background-color: @blue;
    selection-color: #FFFFFF; outline: none; padding: 4px;
}

QScrollBar:vertical { background: transparent; width: 10px; margin: 0; }
QScrollBar::handle:vertical { background: @border; border-radius: 5px; min-height: 40px; }
QScrollBar::add-line:vertical, QScrollBar::sub-line:vertical { height: 0; }
QScrollBar::add-page:vertical, QScrollBar::sub-page:vertical { background: transparent; }

QToolTip { background: @raised; color: @text; border: 1px solid @border; padding: 6px; font-size: 13px; }

QMessageBox { background: @panel; }
QMessageBox QLabel { font-size: 14px; }
QMessageBox QPushButton { min-width: 96px; min-height: 40px; background: @raised; border: 1px solid @border; }
QMessageBox QPushButton:default { background: @blue; border: none; color: #FFFFFF; }

/* ===== Layar perekaman ===== */
QFrame#transportBar { background: @app; border: none; border-bottom: 1px solid @border; }
QFrame#productionBar { background: @panel; border: none; border-top: 1px solid @border; }

QPushButton[variant="transport"] {
    background: @raised; border: 1px solid @border; border-radius: 28px; min-height: 0; padding: 0;
}
QPushButton[variant="transport"]:hover { background: @border; }
QPushButton[variant="transport"][active="true"] { background: #FFFFFF; border: none; }
QPushButton[variant="transport"]:disabled { background: rgba(31, 38, 48, 0.5); }
QPushButton[variant="transportPlay"] { background: @blue; border: none; border-radius: 28px; min-height: 0; padding: 0; }
QPushButton[variant="transportPlay"]:hover { background: @blue_hover; }
QPushButton[variant="transportPlay"]:disabled { background: #24467A; }

QFrame#clockBox, QFrame#infoBox { background: @raised; border: 1px solid @border; border-radius: 8px; }
QLabel[role="clock"] { font-family: @font_mono; font-size: 32px; font-weight: 700; letter-spacing: 1px; }
QLabel[role="clock"][recording="true"] { color: @red; }
QLabel[role="infoTitle"] { font-size: 13px; color: @text2; font-weight: 500; }
QLabel[role="infoValue"] { font-family: @font_mono; font-size: 16px; font-weight: 700; }

QPushButton[variant="metronome"] {
    background: transparent; color: @text2; border: 2px solid @border; min-height: 44px; padding: 0 18px;
    font-size: 16px; font-weight: 600;
}
QPushButton[variant="metronome"]:checked { color: @blue; border: 2px solid @blue; }
QPushButton[variant="metronome"]:disabled { color: rgba(139, 152, 165, 0.5); }

QPushButton#statusPill {
    background: @raised; border: 1px solid @border; border-radius: 17px; min-height: 34px; padding: 0 16px;
    font-family: @font_mono; font-size: 13px; font-weight: 500; color: @text;
}
QPushButton#statusPill[ok="false"] { color: #FCA5A5; border: 1px solid rgba(239, 68, 68, 0.5); }

QFrame#recBanner {
    background: rgba(239, 68, 68, 0.14); border: none; border-left: 4px solid @red;
    border-bottom: 1px solid rgba(239, 68, 68, 0.6);
}
QLabel[role="recBannerText"] { color: @red; font-size: 16px; font-weight: 700; letter-spacing: 1px; }
QLabel[role="recBannerHint"] { color: @text; font-size: 15px; font-weight: 500; }

QFrame#trackStrip { background: @panel; border: 1px solid @border; border-radius: 8px; }
QFrame#trackStrip[selected="true"] { border: 1px solid #4A6FA5; }
QFrame#trackStrip[recording="true"] { border: 2px solid @red; }
QLabel[role="trackName"] { font-size: 17px; font-weight: 600; }

QPushButton[variant="solo"], QPushButton[variant="mute"] {
    background: @raised; border: 1px solid @border; border-radius: 4px; min-height: 0; padding: 0;
    color: @text2; font-size: 15px; font-weight: 700;
}
QPushButton[variant="solo"]:hover, QPushButton[variant="mute"]:hover { color: @text; }
QPushButton[variant="solo"]:checked { background: @yellow; color: #1A1A1A; border: none; }
QPushButton[variant="mute"]:checked { background: @red; color: #FFFFFF; border: none; }

QSlider::groove:horizontal { height: 6px; background: @raised; border-radius: 3px; }
QSlider::sub-page:horizontal { background: @text2; border-radius: 3px; }
QSlider::handle:horizontal { background: @text; width: 12px; margin: -5px 0; border-radius: 6px; }
QSlider::handle:horizontal:hover { background: #FFFFFF; }
QSlider::sub-page:horizontal:disabled { background: @gray; }

QPushButton#takeButton {
    background: @raised; border: 1px solid @border; border-radius: 6px; min-height: 0; padding: 0 10px;
    font-family: @font_mono; font-size: 13px; font-weight: 500; text-align: left;
}
QPushButton#takeButton:hover { border: 1px solid #4A5566; }
QPushButton#takeButton:disabled { color: rgba(139, 152, 165, 0.6); }
QPushButton#takeButton[recording="true"] { color: @red; border: 1px solid @red; }
QPushButton#takeButton[incomplete="true"] { color: @yellow; }

QFrame#takePanel { background: @raised; border: 1px solid @border; border-radius: 10px; }
QFrame#takeRow { background: transparent; border: 1px solid transparent; border-radius: 8px; }
QFrame#takeRow:hover { background: rgba(42, 51, 64, 0.5); }
QFrame#takeRow[active="true"] { background: #243049; border: 1px solid @blue; }
QLabel[role="panelTitle"] { font-size: 16px; font-weight: 600; }
QLabel[role="badgeWarn"] {
    color: @yellow; background: rgba(234, 179, 8, 0.12); border: 1px solid rgba(234, 179, 8, 0.6);
    border-radius: 4px; padding: 1px 6px; font-size: 13px;
}
QRadioButton { font-size: 16px; font-weight: 600; spacing: 12px; }
QRadioButton::indicator { width: 18px; height: 18px; border-radius: 10px; border: 2px solid @text2; }
QRadioButton::indicator:checked { border: 5px solid @blue; background: #FFFFFF; width: 10px; height: 10px; }
QPushButton[variant="danger"] {
    background: transparent; border: none; color: @red; font-size: 16px; font-weight: 500;
    min-height: 40px; padding: 0 8px; text-align: left;
}
QPushButton[variant="danger"]:hover { color: #F87171; }

QPushButton[variant="produce"] {
    background: @blue; color: #FFFFFF; border: none; border-radius: 12px; min-height: 52px;
    padding: 0 28px; font-size: 18px; font-weight: 700;
}
QPushButton[variant="produce"]:hover { background: @blue_hover; }
QPushButton[variant="produce"]:disabled {
    background: @raised; color: rgba(139, 152, 165, 0.7); border: 1px solid @border;
}

QLabel#toast {
    background: @raised; color: @text; border: 1px solid @border; border-radius: 8px;
    padding: 12px 18px; font-size: 15px;
}
QLabel#toast[error="true"] { border: 1px solid @red; color: #FCA5A5; }

/* Wizard persiapan vokal */
QFrame#guideItem { background: @raised; border: 1px solid @border; border-radius: 8px; }
QFrame#guideItem[active="true"] { border: 1px solid @blue; background: #1D2738; }
QLabel[role="guideNum"] {
    font-family: @font_mono; font-size: 14px; font-weight: 600; color: @blue;
    border: 1px solid @border; border-radius: 6px;
}
QLabel[role="guideNum"][active="true"] { background: @blue; color: #FFFFFF; border: none; }
QLabel[role="guideText"] { font-size: 18px; }
QFrame#guidePanel { background: @raised; border: 1px solid @border; border-radius: 10px; }
QLabel[role="peakValue"] { font-family: @font_mono; font-size: 20px; font-weight: 700; }
QLabel[role="levelStatus"] {
    border-radius: 20px; padding: 8px 18px; font-size: 16px; font-weight: 600;
    color: @text2; border: 1px solid @border;
}
QLabel[role="levelStatus"][level="pas"] { color: @green; background: rgba(34, 197, 94, 0.12); border: 1px solid @green; }
QLabel[role="levelStatus"][level="pelan"] { color: @yellow; background: rgba(234, 179, 8, 0.10); border: 1px solid @yellow; }
QLabel[role="levelStatus"][level="keras"] { color: @red; background: rgba(239, 68, 68, 0.10); border: 1px solid @red; }

/* ===== Proses produksi & hasil ===== */
QProgressBar#produceBar { background: @raised; border: 1px solid @border; border-radius: 6px; }
QProgressBar#produceBar::chunk { background: @blue; border-radius: 5px; }
QLabel[role="percent"] { font-size: 20px; font-weight: 700; min-width: 56px; qproperty-alignment: AlignRight; }
QLabel[role="stepLabel"] { font-size: 18px; color: @text; }
QLabel[role="stepLabel"][state="menunggu"] { color: @text2; }
QLabel[role="stepLabel"][state="dilewati"] { color: @text2; }
QLabel[role="stepLabel"][state="berjalan"] { color: #FFFFFF; font-weight: 700; }

QLabel[role="successBadge"] {
    color: @green; background: rgba(34, 197, 94, 0.12); border: 1px solid rgba(34, 197, 94, 0.6);
    border-radius: 16px; padding: 6px 16px; font-size: 15px; font-weight: 500;
}
QLabel[role="readyBadge"] {
    color: @yellow; background: rgba(234, 179, 8, 0.12); border: 1px solid rgba(234, 179, 8, 0.6);
    border-radius: 6px; padding: 4px 10px; font-size: 13px; font-weight: 600;
}
QLabel[role="readyBadge"][ok="true"] { color: @green; background: rgba(34, 197, 94, 0.12); border: 1px solid rgba(34, 197, 94, 0.6); }
QLabel[role="countBadge"] {
    color: @text2; background: @raised; border: 1px solid @border; border-radius: 6px;
    padding: 4px 10px; font-size: 13px;
}
QLabel[role="reportValue"] { font-family: @font_mono; font-size: 16px; font-weight: 700; }
QLabel[role="warningText"] { color: @yellow; font-size: 14px; }
QFrame#fileRow { background: @raised; border: 1px solid @border; border-radius: 8px; }
QLabel[role="fileName"] { font-family: @font_mono; font-size: 14px; }

QPushButton[variant="bigPlay"] { background: @blue; border: none; border-radius: 32px; min-height: 0; padding: 0; }
QPushButton[variant="bigPlay"]:hover { background: @blue_hover; }
QLabel[role="bigClock"] { font-family: @font_mono; font-size: 36px; font-weight: 700; }
QLabel[role="bigClockTotal"] { font-family: @font_mono; font-size: 26px; color: @text2; }
